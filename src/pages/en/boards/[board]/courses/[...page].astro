---
import CoursePageContent from "../../../../../components/pages/CoursePageContent.astro";
import { coursePages } from "../../../../../lib/courses";
export function getStaticPaths() {
  return coursePages.filter((page) => page.lang === "en").map((page) => ({
    params: { board: page.course.board, page: page.course.slug + (page.path ? "/" + page.path.replace(/\/$/, "") : "") },
    props: { page },
  }));
}
const { page } = Astro.props;
---
<CoursePageContent page={page} />
