---
import BoardsHome from "../components/BoardsHome";
import CoursePreview from "../components/CoursePreview.astro";
import Layout from "../layouts/Layout.astro";
import { getAllBoards } from "../lib/data";

const boards = getAllBoards();

if (import.meta.env.DEV) {
  console.log("[boards]", boards);
}
---

<Layout lang="zh" title="RuyiSDK Board Docs">
  <CoursePreview slot="announcement" lang="zh" />
  <BoardsHome client:load boards={boards} lang="zh" />
</Layout>
