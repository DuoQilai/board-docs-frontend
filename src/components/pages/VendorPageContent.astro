---
import {
  getBoardsForSiliconVendorUrlSlug,
  groupBoardsBySiliconVendorChip,
  socSlugFromCpu,
} from "../../lib/data";
import { BoardCard } from "../BoardCard";
import { t, type Lang } from "../../lib/i18n";

interface Props {
  lang: Lang;
  vendorParam: string;
}

const { lang, vendorParam } = Astro.props;
const boards = getBoardsForSiliconVendorUrlSlug(vendorParam);
const label = boards[0]!.socVendor ?? "Unknown";
const tree = groupBoardsBySiliconVendorChip(boards);
const group = tree[0]!;
---

<div class="py-8">
  <header class="mb-8">
    <h1 class="text-foreground text-2xl font-semibold tracking-tight sm:text-3xl">{label}</h1>
    <dl class="text-muted-foreground mt-4 grid max-w-xl grid-cols-3 gap-x-6 gap-y-2 text-sm">
      <div class="flex flex-col gap-0.5">
        <dt class="text-muted-foreground/80 text-xs font-medium uppercase tracking-wide">SoC</dt>
        <dd class="text-foreground text-2xl font-semibold tabular-nums">{group.chips.length}</dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-muted-foreground/80 text-xs font-medium uppercase tracking-wide">{lang === "zh" ? "开发板" : "Boards"}</dt>
        <dd class="text-foreground text-2xl font-semibold tabular-nums">{boards.length}</dd>
      </div>
      <div class="flex flex-col gap-0.5">
        <dt class="text-muted-foreground/80 text-xs font-medium uppercase tracking-wide">{lang === "zh" ? "示例" : "Examples"}</dt>
        <dd class="text-foreground text-2xl font-semibold tabular-nums">{boards.reduce((total, board) => total + board.examples.length, 0)}</dd>
      </div>
    </dl>
  </header>

  <p class="text-muted-foreground mb-6 text-sm leading-6">{t(lang, "vendorBoardsIntro")}</p>
  <hr class="border-border mb-4" />

  <div class="grid gap-y-8">
    {
      group.chips.map((cg) => (
        <section aria-labelledby={`soc-${socSlugFromCpu(cg.cpu)}`}>
          <h2 id={`soc-${socSlugFromCpu(cg.cpu)}`} class="text-foreground mb-4 scroll-mt-6 text-lg font-semibold">
            {cg.cpu}
          </h2>
          <ul class="flex list-none flex-wrap gap-5">
            {cg.boards.map((b) => (
              <li class="w-72 max-w-full">
                <BoardCard
                  lang={lang}
                  product={b.product}
                  slug={b.slug}
                  cpu={b.cpu}
                  vendor={b.vendor}
                  socVendor={b.socVendor}
                  exampleCount={b.examples.length}
                />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>
